# Required: generate a long random secret and use the same value in PASIYA MD bot.
API_KEY=change-this-to-a-long-random-secret
PORT=3000

# Required only for SinhalaSub endpoints
SINHALASUB_API_KEY=

# Optional CineSubz upstream API override
CINESUBZ_API_URL=https://dtz-movie-script.vercel.app/api/movie

# API process protection
MAX_CONCURRENT_JOBS=1
REQUEST_TIMEOUT_MS=120000


# Comma-separated domains that host media you own or are explicitly allowed to download.
# Social-platform page URLs are deliberately not accepted as direct-download sources.
AUTHORIZED_MEDIA_HOSTS=media.example.com,cdn.example.com
